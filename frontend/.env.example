# RoadVision AI - Frontend Environment Configuration Template
# Copy this file to frontend/.env for local development or configure these variables in Vercel

# Backend API Base URL
# For local development with Vite dev proxy, leave blank or set to http://127.0.0.1:8000
# For production deployment on Vercel, set this to your live Render backend URL:
# VITE_API_BASE_URL=https://roadvision-backend.onrender.com
VITE_API_BASE_URL=

# Firebase Client Configuration (from Firebase Console -> Project Settings -> General)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

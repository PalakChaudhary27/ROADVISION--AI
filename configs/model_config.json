{
  "model_name": "RoadVision_DeepLabV3_ResNet50",
  "architecture": "DeepLabV3_ResNet50",
  "backbone": "resnet50",
  "pretrained_weights": "DeepLabV3_ResNet50_Weights.COCO_WITH_VOC_LABELS_V1",
  "in_channels": 3,
  "num_classes": 3,
  "aux_loss": true,
